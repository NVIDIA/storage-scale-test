# Benchmark binaries are ignored, but build_tarball.sh ships them.
/utils/warp*
/utils/elbencho*
/utils/s3test*
/utils/mdtest*
/*.png
/env.sh
/overrides/
/.venv
/.venv-ci
/.obj_auth
/.vscode
__pycache__/
/tmp/
/utils/build/*.log
*.tar.gz
*.tar.xz
.agents
.cursor
.claude
.DS_Store
.pytest_cache/

# Local work and output that build_tarball.sh also leaves out. Ignoring them
# keeps them from marking the project version as modified.
/plans/
/static-binaries/
/bin-amd64/
/bin-arm64/
/results/
/.ci-cache/

# Written only into deployment and source archives.
/VERSION
/SOURCE_SHA256
