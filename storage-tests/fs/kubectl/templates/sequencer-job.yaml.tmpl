# Multi-target attempts only: unsuspend each target's coordinator Job in
# order, starting the next only after the previous one is Complete. This is
# the one Pod that holds an API token; its Roles allow only get and patch on
# this attempt's exact Jobs. The script derives progress from Job state, so a
# replacement Pod resumes where its predecessor stopped.
apiVersion: batch/v1
kind: Job
metadata:
  name: "@@RESOURCE_NAME@@"
  namespace: "@@NAMESPACE@@"
  labels:
    app.kubernetes.io/name: storage-scale-test
    app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
    app.kubernetes.io/component: sequencer
    app.kubernetes.io/managed-by: storage-scale-test
    storage-scale-test.nvidia.com/benchmark: elbencho
    storage-scale-test.nvidia.com/run: "@@ATTEMPT_ID@@"
  annotations:
    storage-scale-test.nvidia.com/ownership: "@@OWNERSHIP_NONCE@@"
spec:
  backoffLimit: 6
  template:
    metadata:
      labels:
        app.kubernetes.io/name: storage-scale-test
        app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
        app.kubernetes.io/component: sequencer
        app.kubernetes.io/managed-by: storage-scale-test
        storage-scale-test.nvidia.com/benchmark: elbencho
        storage-scale-test.nvidia.com/run: "@@ATTEMPT_ID@@"
      annotations:
        storage-scale-test.nvidia.com/ownership: "@@OWNERSHIP_NONCE@@"
    spec:
      serviceAccountName: "@@SERVICE_ACCOUNT_NAME@@"
      automountServiceAccountToken: true
      restartPolicy: Never
      terminationGracePeriodSeconds: 5
      nodeSelector:
@@NODE_SELECTOR_BLOCK@@
      securityContext:
        runAsNonRoot: true
        runAsUser: @@RUN_AS_USER@@
        runAsGroup: @@RUN_AS_GROUP@@
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: sequencer
          image: "@@IMAGE@@"
          imagePullPolicy: @@IMAGE_PULL_POLICY@@
          command:
            - /bin/sh
            - -c
            - |
@@SEQUENCER_SCRIPT@@
            - storage-scale-test-sequencer
          args:
@@SEQUENCER_ARGUMENTS@@
          env:
            - name: HOME
              value: /tmp/storage-scale-test
            - name: KUBECTL_SEQUENCER_POLL_SECONDS
              value: "@@POLL_SECONDS@@"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: scratch
              mountPath: /tmp/storage-scale-test
      volumes:
        - name: scratch
          emptyDir: {}
