# Validation only (validate_env.sh, default mode): run the sequencer's image
# once with no ServiceAccount token and no API call. The image must pull and
# provide sh, kubectl, grep and sleep, and kubectl must run. The host stops
# waiting after the sequencer probe timeout; the deadline and TTL below bound
# an abandoned Job.
apiVersion: batch/v1
kind: Job
metadata:
  name: "@@RESOURCE_NAME@@"
  namespace: "@@NAMESPACE@@"
  labels:
    app.kubernetes.io/name: storage-scale-test
    app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
    app.kubernetes.io/component: validation
    app.kubernetes.io/managed-by: storage-scale-test
    storage-scale-test.nvidia.com/benchmark: elbencho
    storage-scale-test.nvidia.com/run: "@@ATTEMPT_ID@@"
  annotations:
    storage-scale-test.nvidia.com/ownership: "@@OWNERSHIP_NONCE@@"
spec:
  backoffLimit: 0
  activeDeadlineSeconds: @@ACTIVE_DEADLINE_SECONDS@@
  ttlSecondsAfterFinished: 60
  template:
    metadata:
      labels:
        app.kubernetes.io/name: storage-scale-test
        app.kubernetes.io/instance: sst-elb-@@ATTEMPT_ID@@
        app.kubernetes.io/component: validation
        storage-scale-test.nvidia.com/run: "@@ATTEMPT_ID@@"
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      terminationGracePeriodSeconds: 1
      nodeSelector:
@@NODE_SELECTOR_BLOCK@@
      securityContext:
        runAsNonRoot: true
        runAsUser: @@RUN_AS_USER@@
        runAsGroup: @@RUN_AS_GROUP@@
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: sequencer-image-check
          image: "@@IMAGE@@"
          imagePullPolicy: @@IMAGE_PULL_POLICY@@
          command:
            - /bin/sh
            - -c
            - |
                for tool in kubectl grep sleep; do
                    command -v "$tool" >/dev/null 2>&1 || {
                        printf 'the sequencer image lacks %s\n' "$tool" >&2
                        exit 1
                    }
                done
                kubectl version --client >/dev/null || {
                    printf 'kubectl version --client failed in the sequencer image\n' >&2
                    exit 1
                }
                printf 'sequencer image check: sh, kubectl, grep and sleep are present\n'
          env:
            - name: HOME
              value: /tmp/storage-scale-test
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: scratch
              mountPath: /tmp/storage-scale-test
      volumes:
        - name: scratch
          emptyDir: {}
