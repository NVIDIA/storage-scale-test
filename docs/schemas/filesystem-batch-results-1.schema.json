  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storage-scale-test filesystem batch results",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generator",
    "batch",
    "batch_outcome",
    "groups",
    "executions",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "storage-scale-test/filesystem-batch-results"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "batch": {
      "$ref": "#/$defs/batch"
    },
    "batch_outcome": {
      "$ref": "#/$defs/batch_outcome"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "diagnostics": {
      "$ref": "#/$defs/problems"
    }
  },
