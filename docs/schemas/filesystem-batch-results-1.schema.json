    "ledger_counts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "success": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "running": {
          "type": "integer"
        },
        "cancelled": {
          "type": "integer"
        },
        "interrupted": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer"
        }
