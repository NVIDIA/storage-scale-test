          "items": {
            "type": "string"
          }
        },
        "groups_not_reported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete",
        "executions",
        "results",
        "groups_reported",
        "groups_not_reported"
      ]
    },
    "generator": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
