    "result_counts": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "unparseable": {
          "type": "integer"
        },
        "not_run": {
          "type": "integer"
        },
        "not_reported": {
          "type": "integer"
