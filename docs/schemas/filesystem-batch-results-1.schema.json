        "options": {
          "type": "object",
          "properties": {
            "live_detail": true,
            "shortfall_percent": true,
            "min_slow_windows": true,
            "client_max_timeseries_lines": true,
            "client_max_heatmap_rows": true,
            "no_dual_y_axis": true,
            "normalize_to": true,
            "only_nodes": true,
            "only_threads": true,
            "only_sizes": true,
            "only_iodepths": true,
            "groups": true,
            "kind": true
